{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "app.yaml",
      "README.md",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.svg",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
